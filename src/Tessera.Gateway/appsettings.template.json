{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Scalar": {
    "ClientId": "client_id_keycloak",
    "ServiceScopes": [ "wallet_scope", "history_scope", "orchestrator_scope" ],
    "AuthorizationUrl": "https://localhost:XXX/realms/YOUR_REALM/protocol/openid-connect/auth"
  },
  "ReverseProxy": {
    "Routes": {
      "wallet": {
        "ClusterId": "wallet",
        "Match": { "Path": "/wallets/{**catch-all}" }
      },
      "orchestrator": {
        "ClusterId": "orchestrator",
        "Match": { "Path": "/bets/{**catch-all}" }
      },
      "history": {
        "ClusterId": "history",
        "Match": { "Path": "/history/{**catch-all}" }
      },
      "notifications": {
        "ClusterId": "notifications",
        "Match": { "Path": "/hubs/{**catch-all}" }
      },

      // OpenAPI proxy routes
      "wallet-openapi": {
        "ClusterId": "wallet",
        "Match": { "Path": "/openapi/wallet.api.json" }
      },
      "orchestrator-openapi": {
        "ClusterId": "orchestrator",
        "Match": { "Path": "/openapi/orchestrator.api.json" }
      },
      "history-openapi": {
        "ClusterId": "history",
        "Match": { "Path": "/openapi/history.api.json" }
      }
    },
    "Clusters": {
      "wallet": { "Destinations": { "d1": { "Address": "https://wallet-api" } } },
      "orchestrator": { "Destinations": { "d1": { "Address": "https://orchestrator" } } },
      "history": { "Destinations": { "d1": { "Address": "https://history-api" } } },
      "notifications": { "Destinations": { "d1": { "Address": "https://notifications" } } }
    }
  }
}
