{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scalar": {
    "Security": {
      "ClientId": "client_id_keycloak",
      "AuthorizationUrl": "https://localhost:XXX/realms/YOUR_REALM/protocol/openid-connect/auth"
    }
  },
  "Docs": {
    "Title": "History API",
    "Version": "history.api"
  },
  "Authorization": {
    "Audience": "audience_keycloak"
  },
  "AllowedHosts": "*"
}
